# Telegram bot token (@BotFather'dan alınır)
BOT_TOKEN=

# Botu kullanabilecek Telegram kullanıcı ID'leri (virgülle ayrılmış)
# ID öğrenmek için @userinfobot kullanabilirsiniz.
ADMIN_IDS=123456789

# Instagram hesap bilgileri (bot bu hesapla oturum açar)
IG_USERNAME=
IG_PASSWORD=

# Günlük otomatik kontrol saati (SS:DD, 24 saat formatı)
CHECK_TIME=09:00

# Dosya yolları (opsiyonel, varsayılanlar genelde yeterlidir)
DATABASE_PATH=data/bot.db
IG_SESSION_PATH=data/ig_session
LOG_DIR=logs

# Her kontrolde hesap başına bakılacak en yeni gönderi sayısı
POST_FETCH_LIMIT=5

# Zaman dilimi (günlük görev bu saat dilimine göre çalışır)
TIMEZONE=Europe/Istanbul
